# Raw frames and .blend files (several GB, regenerated by tools/render.py / render.sh)
renders/

# Python environments (recreate per machine, see SETUP_WINDOWS.md)
.venv/
.venv-kokoro/
__pycache__/
*.pyc

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Voice model binaries (large; download links in SETUP_WINDOWS.md)
audio/voices/*.onnx
audio/voices/*.onnx.json
audio/voices/kokoro/*.onnx
audio/voices/kokoro/*.bin

# Rendered videos (regenerate with tools/render.py and tools/assemble.py)
exports/*.mp4
previews/*.mp4

# Local ffmpeg binaries on Windows (see SETUP_WINDOWS.md)
tools/bin/

# Secrets
.env
.env.*
