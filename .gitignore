# Raw rendered frame folders (~4.5 GB of PNG frames, regenerated by tools/render.py / render.sh).
# The scene files in renders/ (*.blend via Git LFS, *_cues.json, *.ass) ARE tracked.
renders/*/

# Blender auto-backup copies (written next to every .blend on save)
*.blend1

# Python environments (recreate per machine, see SETUP_WINDOWS.md)
.venv/
.venv-kokoro/
__pycache__/
*.pyc

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Voice models (audio/voices/**/*.onnx, *.bin) and rendered videos (exports/, previews/)
# are tracked via Git LFS, see .gitattributes.

# Local ffmpeg binaries on Windows (see SETUP_WINDOWS.md)
tools/bin/

# Secrets
.env
.env.*
